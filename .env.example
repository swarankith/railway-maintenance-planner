# ============================================================
# AI-Assisted Railway Maintenance Block Planner - Environment Config
# ============================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Database Connection (Defaults to SQLite; supports PostgreSQL, MySQL etc.)
DATABASE_URL=sqlite:///./railway_planner.db
# Example for PostgreSQL:
# DATABASE_URL=postgresql://user:password@hostname:5432/railway_db

# Frontend API URL
# Leave blank for local monolithic / proxied deployment.
# For decoupled frontend deployment (e.g. Vercel/Netlify pointing to backend):
# VITE_API_URL=https://your-backend-service.com
VITE_API_URL=
